# Optional override. Defaults to %LOCALAPPDATA%\UofTFreeFoodFinder\foodfinder.sqlite3.
# FOODFINDER_DB=
FOODFINDER_HOST=127.0.0.1
FOODFINDER_PORT=8000
FOODFINDER_SCAN_INTERVAL_HOURS=6
FOODFINDER_DISCOVERY_INTERVAL_DAYS=7
FOODFINDER_POST_LIMIT=100
FOODFINDER_POST_AGE_DAYS=60
# auto prefers Intel GPU when available; cpu forces CPU; xpu requests Intel GPU.
# Set these variables in PowerShell; this example file is not loaded automatically.
FOODFINDER_OCR_DEVICE=auto
# Single-image GPU OCR was fastest in the local benchmark. Optional range: 1-16.
FOODFINDER_OCR_BATCH_SIZE=1
